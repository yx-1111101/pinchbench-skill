# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.
#
# Shell exports always take precedence over values here,
# so you can still override per-session with: export KEY=value

# OpenRouter (required for most models and the default judge)
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic direct API (only needed when using --judge anthropic/...)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direct API (only needed when using --judge openai/...)
# OPENAI_API_KEY=sk-...

# Official leaderboard submission key (optional)
# PINCHBENCH_OFFICIAL_KEY=...
