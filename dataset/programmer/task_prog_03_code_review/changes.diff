-def get_user_events(user_id):
-    pass
+DB_PATH = "analytics.db"
 
-def build_report(user_id):
-    pass
+
+def get_user_events(user_id, start_date=None, end_date=None):
+    """查询指定用户在日期范围内的行为事件"""
+    conn = sqlite3.connect(DB_PATH)
+
+    # Build dynamic query based on optional filters
+    query = f"SELECT * FROM events WHERE user_id = '{user_id}'"
+    if start_date:
+        query += f" AND event_date >= '{start_date}'"
+    if end_date:
+        query += f" AND event_date <= '{end_date}'"
+
+    df = pd.read_sql_query(query, conn)
+    conn.close()
+    return df
+
+
+def compute_metrics(df):
+    """计算用户行为指标"""
+    metrics = {}
+
+    # 总事件数
+    metrics["total_events"] = len(df)
+
+    # 按事件类型统计
+    type_counts = {}
+    for _, row in df.iterrows():
+        event_type = row["event_type"]
+        if event_type not in type_counts:
+            type_counts[event_type] = 0
+        type_counts[event_type] += 1
+    metrics["by_type"] = type_counts
+
+    # 计算活跃天数
+    metrics["active_days"] = df["event_date"].nunique()
+
+    # 最近一次活跃时间
+    metrics["last_active"] = df["event_date"].max()
+
+    return metrics
+
+
+def build_report(user_id, start_date=None, end_date=None):
+    """生成用户行为报告并写回数据库"""
+    df = get_user_events(user_id, start_date, end_date)
+
+    if df.empty:
+        return {"user_id": user_id, "status": "no_data"}
+
+    metrics = compute_metrics(df)
+
+    # 写入报告表
+    conn = sqlite3.connect(DB_PATH)
+    report_df = pd.DataFrame([{
+        "user_id": user_id,
+        "generated_at": datetime.now().isoformat(),
+        "total_events": metrics["total_events"],
+        "active_days": metrics["active_days"],
+        "last_active": metrics["last_active"],
+    }])
+    report_df.to_sql("user_reports", conn, if_exists="append", index=False)
+    conn.close()
+
+    return metrics
